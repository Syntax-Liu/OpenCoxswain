{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "typeRoots": [
      "../../node_modules/@types",
      "../desktop/node_modules/@types"
    ],
    "paths": {
      "react": ["../desktop/node_modules/@types/react"],
      "react/jsx-runtime": ["../desktop/node_modules/@types/react/jsx-runtime"],
      "react-dom": ["../desktop/node_modules/@types/react-dom"],
      "react-dom/client": ["../desktop/node_modules/@types/react-dom/client"],
      "vite": ["../desktop/node_modules/vite"],
      "@vitejs/plugin-react": ["../desktop/node_modules/@vitejs/plugin-react"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/test/**", "dist-test"]
}
