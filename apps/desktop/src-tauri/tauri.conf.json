{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCoxswain",
  "version": "0.34.0",
  "identifier": "com.opencoxswain.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @opencoxswain/daemon... build && pnpm --filter @opencoxswain/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -w build && pnpm -w package:daemon",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFRTYwNTA5NDk3RDQyRkUKUldUK1FuMUpDUVhtcmhMaU5LSzd3cVl2UnFkSkJsbExHWlltYVpVMGgrelk2Z3hrUGluZDBSZ00K"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["staging"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
